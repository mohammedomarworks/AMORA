<Window x:Class="AMORA.Orbit.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AMORA Settings">
 <Grid x:Name="Root" Background="#292A2C" RequestedTheme="Dark" ColumnDefinitions="220,*">
  <Grid Background="#303133" Padding="14,24" RowDefinitions="Auto,*,Auto" RowSpacing="26">
   <StackPanel Margin="10,0"><TextBlock Text="●  AMORA" Foreground="{ThemeResource OrbitCyanAccentBrush}" FontSize="25" FontWeight="Bold"/><TextBlock Text="Settings" Margin="30,3,0,0" FontSize="14" Foreground="#B8BBC1"/></StackPanel>
   <ListBox x:Name="Sections" Grid.Row="1" SelectionChanged="OnSectionChanged" SelectedIndex="0" Background="Transparent" BorderThickness="0">
    <ListBoxItem Tag="Appearance" AutomationProperties.Name="Appearance" CornerRadius="10" Padding="10,8" Margin="0,0,0,5"><StackPanel Orientation="Horizontal" Spacing="10"><Border Background="#AB45CE" Width="28" Height="28" CornerRadius="8"><FontIcon Glyph="&#xE790;" Foreground="White" FontSize="16"/></Border><TextBlock Text="Appearance" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem Tag="Behavior" AutomationProperties.Name="Behavior" CornerRadius="10" Padding="10,8" Margin="0,0,0,5"><StackPanel Orientation="Horizontal" Spacing="10"><Border Background="#2877CF" Width="28" Height="28" CornerRadius="8"><FontIcon Glyph="&#xE962;" Foreground="White" FontSize="16"/></Border><TextBlock Text="Behavior" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem Tag="Sounds" AutomationProperties.Name="Sounds" CornerRadius="10" Padding="10,8" Margin="0,0,0,5"><StackPanel Orientation="Horizontal" Spacing="10"><Border Background="#D63F69" Width="28" Height="28" CornerRadius="8"><FontIcon Glyph="&#xE767;" Foreground="White" FontSize="16"/></Border><TextBlock Text="Sounds" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem Tag="AI" AutomationProperties.Name="AI Assistant" CornerRadius="10" Padding="10,8" Margin="0,0,0,5"><StackPanel Orientation="Horizontal" Spacing="10"><Border Background="#665ED3" Width="28" Height="28" CornerRadius="8"><FontIcon Glyph="&#xE945;" Foreground="White" FontSize="16"/></Border><TextBlock Text="AI Assistant" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem Tag="Context" AutomationProperties.Name="Context &amp; Proactive" CornerRadius="10" Padding="10,8" Margin="0,0,0,5"><StackPanel Orientation="Horizontal" Spacing="10"><Border Background="#259BA5" Width="28" Height="28" CornerRadius="8"><FontIcon Glyph="&#xE890;" Foreground="White" FontSize="16"/></Border><TextBlock Text="Context &amp; Proactive" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem Tag="Memory" AutomationProperties.Name="Memory" CornerRadius="10" Padding="10,8" Margin="0,0,0,5"><StackPanel Orientation="Horizontal" Spacing="10"><Border Background="#3EAC65" Width="28" Height="28" CornerRadius="8"><FontIcon Glyph="&#xE8B7;" Foreground="White" FontSize="16"/></Border><TextBlock Text="Memory" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem Tag="Modules" AutomationProperties.Name="Modules &amp; Media" CornerRadius="10" Padding="10,8" Margin="0,0,0,5"><StackPanel Orientation="Horizontal" Spacing="10"><Border Background="#CA8736" Width="28" Height="28" CornerRadius="8"><FontIcon Glyph="&#xE80A;" Foreground="White" FontSize="16"/></Border><TextBlock Text="Modules &amp; Media" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem Tag="Automations" AutomationProperties.Name="Automations" CornerRadius="10" Padding="10,8" Margin="0,0,0,5"><StackPanel Orientation="Horizontal" Spacing="10"><Border Background="#C39932" Width="28" Height="28" CornerRadius="8"><FontIcon Glyph="&#xE945;" Foreground="White" FontSize="16"/></Border><TextBlock Text="Automations" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></ListBoxItem><ListBoxItem Tag="About" AutomationProperties.Name="About" CornerRadius="10" Padding="10,8" Margin="0,0,0,5"><StackPanel Orientation="Horizontal" Spacing="10"><Border Background="#7F848C" Width="28" Height="28" CornerRadius="8"><FontIcon Glyph="&#xE946;" Foreground="White" FontSize="16"/></Border><TextBlock Text="About" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
   </ListBox>
   <TextBlock Grid.Row="2" Text="{Binding Presentation.Theme}" Foreground="{ThemeResource OrbitCyanAccentBrush}" FontSize="13" Margin="10,0"/>
  </Grid>
  <Grid Grid.Column="1" Padding="28,26" RowDefinitions="Auto,*,Auto" RowSpacing="22">
   <StackPanel Spacing="8"><TextBlock x:Name="SectionTitle" Text="Appearance" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="SectionDescription" TextWrapping="Wrap" Foreground="#B8BBC1" FontSize="14"/></StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid>
    <StackPanel x:Name="AppearancePanel" Spacing="20">
     <TextBlock Text="Theme &amp; Accent" FontSize="19" FontWeight="SemiBold"/>
     <TextBlock Text="AMORA's surfaces, controls and character glow update instantly." TextWrapping="Wrap" Foreground="#B8BBC1"/>
     <Border Background="#222326" CornerRadius="16" Padding="14"><StackPanel Spacing="14">
      <Grid x:Name="ThemeChoices" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
       <Button Tag="Midnight" Click="OnTheme" HorizontalAlignment="Stretch" Padding="8,12" CornerRadius="12"><StackPanel Spacing="10"><Ellipse Width="30" Height="30" Fill="#52CCFF"/><TextBlock Text="Midnight" FontSize="12"/></StackPanel></Button>
       <Button Grid.Column="1" Tag="Ocean" Click="OnTheme" HorizontalAlignment="Stretch" Padding="8,12" CornerRadius="12"><StackPanel Spacing="10"><Ellipse Width="30" Height="30" Fill="#24C4CB"/><TextBlock Text="Ocean" FontSize="12"/></StackPanel></Button>
       <Button Grid.Column="2" Tag="Bubblegum" Click="OnTheme" HorizontalAlignment="Stretch" Padding="8,12" CornerRadius="12"><StackPanel Spacing="10"><Ellipse Width="30" Height="30" Fill="#FF72B6"/><TextBlock Text="Bubblegum" FontSize="12"/></StackPanel></Button>
       <Button Grid.Column="3" Tag="Matrix" Click="OnTheme" HorizontalAlignment="Stretch" Padding="8,12" CornerRadius="12"><StackPanel Spacing="10"><Ellipse Width="30" Height="30" Fill="#35EF78"/><TextBlock Text="Matrix" FontSize="12"/></StackPanel></Button>
       <Button Grid.Column="4" Tag="Minimal" Click="OnTheme" HorizontalAlignment="Stretch" Padding="8,12" CornerRadius="12"><StackPanel Spacing="10"><Ellipse Width="30" Height="30" Fill="#DDE2EE"/><TextBlock Text="Minimal" FontSize="12"/></StackPanel></Button>
      </Grid>
      <Border Background="#33434A" CornerRadius="10" Padding="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Presentation.Theme}" Foreground="{ThemeResource OrbitCyanAccentBrush}"/><TextBlock Grid.Column="1" Text="Active theme" Foreground="{ThemeResource OrbitCyanAccentBrush}"/></Grid></Border>
     </StackPanel></Border>
     <TextBlock Text="Sizing &amp; Transparency" FontSize="19" FontWeight="SemiBold"/>
     <Border Background="#222326" CornerRadius="16" Padding="18"><StackPanel Spacing="20">
      <Grid ColumnDefinitions="*,200,60" ColumnSpacing="14"><StackPanel><TextBlock Text="AMORA Size" FontSize="16"/><TextBlock Text="Scales the companion within the island." TextWrapping="Wrap" FontSize="12" Foreground="#B8BBC1"/></StackPanel><Slider Grid.Column="1" Minimum="24" Maximum="48" StepFrequency="1" Value="{Binding Presentation.MascotSize, Mode=TwoWay}" AutomationProperties.Name="AMORA size"/><TextBlock Grid.Column="2" Text="{Binding Presentation.SizeLabel}" VerticalAlignment="Center"/></Grid>
      <Grid ColumnDefinitions="*,200,60" ColumnSpacing="14"><StackPanel><TextBlock Text="Surface Opacity" FontSize="16"/><TextBlock Text="Controls the island surface intensity." TextWrapping="Wrap" FontSize="12" Foreground="#B8BBC1"/></StackPanel><Slider Grid.Column="1" Minimum=".5" Maximum="1" StepFrequency=".05" Value="{Binding Presentation.SurfaceOpacity, Mode=TwoWay}" AutomationProperties.Name="Surface opacity"/><TextBlock Grid.Column="2" Text="{Binding Presentation.OpacityLabel}" VerticalAlignment="Center"/></Grid>
     </StackPanel></Border>
     <TextBlock Text="Motion &amp; Animation" FontSize="19" FontWeight="SemiBold"/>
     <Border Background="#222326" CornerRadius="16" Padding="18"><StackPanel><Grid ColumnDefinitions="*,200,60" ColumnSpacing="14"><TextBlock Text="Animation intensity" FontSize="16" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="1" StepFrequency=".1" Value="{Binding Presentation.MotionIntensity, Mode=TwoWay}" AutomationProperties.Name="Motion intensity"/><TextBlock Grid.Column="2" Text="{Binding Presentation.MotionLabel}" VerticalAlignment="Center"/></Grid><TextBlock Text="Windows reduced-motion preferences always take priority." FontSize="12" Foreground="#B8BBC1" TextWrapping="Wrap"/></StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="BehaviorPanel" Visibility="Collapsed" Spacing="18">
     <ToggleSwitch Header="Hover to expand" IsOn="{Binding Presentation.HoverToExpand, Mode=TwoWay}"/>
     <ToggleSwitch Header="Avoid fullscreen games and presentations" IsOn="{Binding Presentation.AvoidFullscreen, Mode=TwoWay}"/>
     <TextBlock Text="Auto-collapse delay" FontSize="16"/><Slider Minimum=".5" Maximum="15" StepFrequency=".5" Value="{Binding Presentation.AutoCollapseSeconds, Mode=TwoWay}" AutomationProperties.Name="Auto collapse delay"/><TextBlock Text="{Binding Presentation.CollapseLabel}"/>
     <ToggleSwitch Header="Sleep when idle" IsOn="{Binding Presentation.SleepMode, Mode=TwoWay}"/><Slider Minimum="30" Maximum="1800" StepFrequency="30" Value="{Binding Presentation.IdleTimeoutSeconds, Mode=TwoWay}" AutomationProperties.Name="Idle sleep timeout"/><TextBlock Text="{Binding Presentation.IdleLabel}"/>
     <TextBlock Text="Ctrl+Alt+O toggles the island. Alt+1 opens Home; Alt+2 opens Talk. Escape returns to Home, then collapses. The tray also provides access." TextWrapping="Wrap" Foreground="#B8BBC1"/>
    </StackPanel>
    <StackPanel x:Name="SoundsPanel" Visibility="Collapsed" Spacing="18"><ToggleSwitch Header="Companion sound effects" IsOn="{Binding Presentation.SoundEnabled, Mode=TwoWay}"/><TextBlock Text="Sound volume"/><Slider Minimum="0" Maximum="1" StepFrequency=".05" Value="{Binding Presentation.SoundVolume, Mode=TwoWay}" AutomationProperties.Name="Sound volume"/><TextBlock Text="{Binding Presentation.VolumeLabel}"/><Button Content="Preview sound" Click="OnPreviewSound"/><TextBlock x:Name="SoundStatus" TextWrapping="Wrap" Foreground="#B8BBC1"/><TextBlock Text="Uses Windows' own notification sound for timer completion and explicit previews. Disabled sound effects remain silent." TextWrapping="Wrap" Foreground="#B8BBC1"/></StackPanel>
    <StackPanel x:Name="AiPanel" Visibility="Collapsed" Spacing="20">
     <TextBlock Text="Intelligence provider" FontSize="18" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Settings.Providers}" SelectedItem="{Binding Settings.SelectedProvider, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="AI provider"/>
     <TextBox Visibility="{Binding Settings.IsCloudSelected, Converter={StaticResource BoolToVis}}" Header="Cloud model ID" Text="{Binding Settings.ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="AI model"/>
     <PasswordBox Visibility="{Binding Settings.IsCloudSelected, Converter={StaticResource BoolToVis}}" x:Name="SettingsApiKeyBox" Header="{Binding Settings.CredentialLabel}" PlaceholderText="Encrypted for your Windows account" PasswordChanged="OnKeyChanged"/>
     <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save provider" Click="OnSaveProvider"/><Button Content="Test connection" Click="OnTestProvider" IsEnabled="{Binding Settings.CanTest}"/><Button Content="Delete saved key" Click="OnDeleteKey" Visibility="{Binding Settings.HasSavedKey, Converter={StaticResource BoolToVis}}"/></StackPanel>
     <TextBlock Text="{Binding Settings.TestStatusMessage}" TextWrapping="Wrap" Foreground="{ThemeResource OrbitCyanAccentBrush}"/>
     <Border Background="#222326" CornerRadius="16" Padding="18"><StackPanel Spacing="12">
      <TextBlock Text="Local Brain · on-device inference" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Install a verified model and the Windows CPU runtime once. Local Brain then works without a cloud account. Missing models never trigger a silent cloud fallback." TextWrapping="Wrap" FontSize="12" Foreground="#B8BBC1"/>
      <ComboBox ItemsSource="{Binding LocalBrain.Models}" DisplayMemberPath="DownloadLabel" SelectedValuePath="Id" SelectedValue="{Binding LocalBrain.SelectedModelId, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Local Brain model"/>
      <ProgressBar Value="{Binding LocalBrain.ProgressPercent}" Maximum="100"/><TextBlock Text="{Binding LocalBrain.StatusMessage}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
      <StackPanel Orientation="Horizontal" Spacing="6"><Button Content="Install" Click="OnInstallBrain" IsEnabled="{Binding LocalBrain.CanOperate}"/><Button Content="Start" Click="OnStartBrain" IsEnabled="{Binding LocalBrain.CanOperate}"/><Button Content="Stop" Click="OnStopBrain"/><Button Content="Cancel" Click="OnCancelBrain"/><Button Content="Remove model" Click="OnDeleteBrain" IsEnabled="{Binding LocalBrain.CanOperate}"/></StackPanel>
      <Button Content="Use this Local Brain model" Click="OnUseBrain" IsEnabled="{Binding LocalBrain.CanOperate}" HorizontalAlignment="Stretch"/>
     </StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="ContextPanel" Visibility="Collapsed" Spacing="18"><ToggleSwitch Header="Share AMORA system status with AI" IsOn="{Binding Settings.SendStatusContextToAI, Mode=TwoWay}"/><TextBlock Text="Off by default. Includes current AMORA timer, media, battery and system metrics. It does not collect screenshots, window content, file contents or keystrokes." TextWrapping="Wrap" Foreground="#B8BBC1"/><ToggleSwitch Header="Enable proactive suggestions" IsOn="{Binding Settings.EnableProactiveSuggestions, Mode=TwoWay}"/><TextBlock Text="Suggestions stay local and need your action. Explicit automation reminders remain available separately." TextWrapping="Wrap" Foreground="#B8BBC1"/><Button Content="Save privacy settings" Click="OnSaveProvider"/><TextBlock Text="{Binding Settings.TestStatusMessage}" TextWrapping="Wrap"/></StackPanel>
    <StackPanel x:Name="MemoryPanel" Visibility="Collapsed" Spacing="18"><ToggleSwitch Header="Explicit local memory" IsOn="{Binding Settings.MemoryEnabled, Mode=TwoWay}"/><TextBlock Text="Facts are encrypted for your Windows user account. Session chat is separate. Memory is saved only when you explicitly ask, and is excluded from cloud conversation history." TextWrapping="Wrap" Foreground="#B8BBC1"/><TextBlock Text="Try: remember my editor is VS Code · recall my editor · list memories · forget my editor. Clearing all memories requires confirmation." TextWrapping="Wrap"/><Button Content="Review memories in Talk" Click="OnReviewMemories"/><Button Content="Save memory preference" Click="OnSaveProvider"/><TextBlock Text="{Binding Settings.TestStatusMessage}" TextWrapping="Wrap"/></StackPanel>
    <StackPanel x:Name="ModulesPanel" Visibility="Collapsed" Spacing="18"><ToggleSwitch Header="Music controls on Home" IsOn="{Binding Presentation.MusicEnabled, Mode=TwoWay}"/><ToggleSwitch Header="Timer on Home" IsOn="{Binding Presentation.TimerEnabled, Mode=TwoWay}"/><ToggleSwitch Header="Battery / power on Home" IsOn="{Binding Presentation.BatteryEnabled, Mode=TwoWay}"/><ToggleSwitch Header="CPU and RAM on Home" IsOn="{Binding Presentation.SystemMonitorEnabled, Mode=TwoWay}"/><ToggleSwitch Header="Clipboard history" IsOn="{Binding Settings.EnableClipboardHistory, Mode=TwoWay}"/><TextBlock Text="Clipboard capture is off by default. Enabling captures future copied text only, filters sensitive formats, and clears history on exit. Media uses real participating Windows media sessions; individual players may expose different controls." TextWrapping="Wrap" Foreground="#B8BBC1"/><Border Background="#222326" CornerRadius="14" Padding="16"><StackPanel Spacing="12"><TextBlock Text="YouTube browser bridge" FontSize="18" FontWeight="SemiBold"/><ToggleSwitch Header="Enable browser media integration" IsOn="{Binding Presentation.BrowserBridgeEnabled, Mode=TwoWay}"/><TextBlock Text="{Binding BrowserBridge.ConnectionStatus}" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="Register the included host, then load the bundled browser-extension folder in Chrome or Edge's extension developer page. Registration applies to this Windows account only. No website content is read beyond the active YouTube player's media state." TextWrapping="Wrap" Foreground="#B8BBC1" FontSize="12"/><TextBlock Text="{Binding BrowserBridge.ExtensionFolder}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="11"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Register browser host" Click="OnRegisterBrowser" IsEnabled="{Binding BrowserBridge.CanRegister}"/><Button Content="Remove registration" Click="OnUnregisterBrowser" IsEnabled="{Binding BrowserBridge.CanRegister}"/></StackPanel><TextBlock Text="{Binding BrowserBridge.RegistrationStatus}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border><Button Content="Save clipboard preference" Click="OnSaveProvider"/><TextBlock Text="{Binding Settings.TestStatusMessage}" TextWrapping="Wrap"/></StackPanel>
    <StackPanel x:Name="AutomationSettingsPanel" Visibility="Collapsed" Spacing="18"><TextBlock Text="Local schedules and allowlisted actions" FontSize="18"/><TextBlock Text="Create reminders, focus timers and media actions in the island. AI cannot create or enable schedules. Schedule changes are saved before activation; missed recurring runs are skipped without bursts." TextWrapping="Wrap" Foreground="#B8BBC1"/><Button Content="Open automations" Click="OnOpenAutomations"/></StackPanel>
    <StackPanel x:Name="AboutPanel" Visibility="Collapsed" Spacing="18"><TextBlock Text="AMORA for Windows" FontSize="24" FontWeight="Bold"/><TextBlock Text="0.6.0-beta.2 · local development build" FontSize="16"/><TextBlock Text="Native WinUI 3 · Windows media sessions · DPAPI-secured credentials and explicit memory. This build is an ongoing Mac-to-Windows parity implementation." TextWrapping="Wrap" Foreground="#B8BBC1"/><TextBlock Text="No analytics, screenshots or hidden cloud context collection." TextWrapping="Wrap"/></StackPanel>
   </Grid></ScrollViewer>
   <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{Binding Presentation.Status}" TextWrapping="Wrap" FontSize="12" Foreground="#B8BBC1" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Save preferences" Style="{StaticResource OrbitPrimaryActionButtonStyle}" Click="OnSavePreferences"/></Grid>
  </Grid>
 </Grid>
</Window>
