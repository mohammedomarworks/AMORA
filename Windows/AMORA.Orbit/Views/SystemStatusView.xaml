<UserControl x:Class="AMORA.Orbit.Views.SystemStatusView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
  <Border x:Name="BatteryCard" Background="{ThemeResource OrbitCardBrush}" BorderBrush="#3D535D" BorderThickness="1" CornerRadius="12" Padding="12,10">
   <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><FontIcon Glyph="{Binding BatteryGlyph}" FontSize="16" Foreground="{ThemeResource OrbitCyanAccentBrush}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding BatteryHeadline}" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding BatteryDetail}" Foreground="#A6ABB2" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
  </Border>
  <Border x:Name="TelemetryCard" Grid.Column="1" Background="{ThemeResource OrbitCardBrush}" BorderBrush="#3D535D" BorderThickness="1" CornerRadius="12" Padding="12,10">
   <StackPanel Spacing="4" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE950;" FontSize="11" Foreground="{ThemeResource OrbitCyanAccentBrush}"/><TextBlock Text="{Binding CpuFormatted}" FontSize="11"/><TextBlock Text="CPU" FontSize="11" Foreground="#A6ABB2"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE964;" FontSize="11" Foreground="{ThemeResource OrbitCyanAccentBrush}"/><TextBlock Text="{Binding RamUsageDetail}" FontSize="11" Foreground="#A6ABB2"/><TextBlock Text="RAM" FontSize="11" Foreground="#A6ABB2"/></StackPanel></StackPanel>
  </Border>
 </Grid>
</UserControl>
