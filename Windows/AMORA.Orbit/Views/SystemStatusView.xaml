<UserControl
    x:Class="AMORA.Orbit.Views.SystemStatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AMORA.Orbit.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SystemStatusViewModel}">

    <Border Background="{StaticResource OrbitCardBrush}"
            BorderBrush="{StaticResource OrbitBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14,10">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
            <!-- Battery / Power Source -->
            <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                <FontIcon Grid.Column="0"
                          Glyph="{Binding BatteryGlyph}"
                          FontSize="16"
                          Foreground="{StaticResource OrbitCyanAccentBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Power"
                                   FontSize="11"
                                   Foreground="{StaticResource OrbitTextMutedBrush}" />
                        <TextBlock Text="{Binding BatteryStatusText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource OrbitTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- Mini Battery Bar (hidden on Desktop AC) -->
                    <ProgressBar Value="{Binding BatteryPercent}"
                                 Maximum="100"
                                 Height="3"
                                 Margin="0,3,0,0"
                                 CornerRadius="1.5"
                                 Foreground="{StaticResource OrbitCyanAccentBrush}"
                                 Background="#1F2433" />
                </StackPanel>
            </Grid>

            <!-- CPU Usage -->
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                <FontIcon Grid.Column="0"
                          Glyph="&#xE950;"
                          FontSize="15"
                          Foreground="{StaticResource OrbitCyanAccentBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="CPU" FontSize="11" Foreground="{StaticResource OrbitTextMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding CpuFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OrbitTextPrimaryBrush}" />
                    </Grid>
                    <ProgressBar Value="{Binding CpuPercent}"
                                 Maximum="100"
                                 Height="3"
                                 Margin="0,3,0,0"
                                 CornerRadius="1.5"
                                 Foreground="{StaticResource OrbitCyanAccentBrush}"
                                 Background="#1F2433" />
                </StackPanel>
            </Grid>

            <!-- RAM Usage -->
            <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                <FontIcon Grid.Column="0"
                          Glyph="&#xE964;"
                          FontSize="15"
                          Foreground="{StaticResource OrbitCyanAccentBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Memory" FontSize="11" Foreground="{StaticResource OrbitTextMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding RamFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OrbitTextPrimaryBrush}" />
                    </Grid>
                    <ProgressBar Value="{Binding RamPercent}"
                                 Maximum="100"
                                 Height="3"
                                 Margin="0,3,0,0"
                                 CornerRadius="1.5"
                                 Foreground="{StaticResource OrbitCyanAccentBrush}"
                                 Background="#1F2433" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
