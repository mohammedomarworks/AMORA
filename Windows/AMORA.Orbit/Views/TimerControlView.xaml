<UserControl
    x:Class="AMORA.Orbit.Views.TimerControlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AMORA.Orbit.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:TimerControlViewModel}">

    <Border Background="{StaticResource OrbitCardBrush}"
            BorderBrush="{StaticResource OrbitBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14,12">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE916;" FontSize="13" Foreground="{StaticResource OrbitCyanAccentBrush}" />
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource OrbitTextPrimaryBrush}" />
                </StackPanel>

                <!-- Time Display -->
                <TextBlock Grid.Column="2"
                           Text="{Binding TimeRemainingFormatted}"
                           FontSize="14"
                           FontWeight="Bold"
                           FontFamily="Cascadia Code, Consolas, Segoe UI"
                           Foreground="{StaticResource OrbitCyanAccentBrush}" />
            </Grid>

            <!-- Progress Bar -->
            <ProgressBar Grid.Row="1"
                         Value="{Binding ProgressRatio, Mode=OneWay}"
                         Maximum="1.0"
                         Height="4"
                         CornerRadius="2"
                         Foreground="{StaticResource OrbitCyanAccentBrush}"
                         Background="#1F2433" />

            <!-- Presets & Controls -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <!-- Preset Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource OrbitActionButtonStyle}"
                            Padding="8,4"
                            FontSize="11"
                            Click="OnPreset5Clicked">
                        <TextBlock Text="5m" />
                    </Button>
                    <Button Style="{StaticResource OrbitActionButtonStyle}"
                            Padding="8,4"
                            FontSize="11"
                            Click="OnPreset15Clicked">
                        <TextBlock Text="15m" />
                    </Button>
                    <Button Style="{StaticResource OrbitActionButtonStyle}"
                            Padding="8,4"
                            FontSize="11"
                            Click="OnPreset25Clicked">
                        <TextBlock Text="25m Focus" />
                    </Button>
                </StackPanel>

                <!-- Control Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Style="{StaticResource OrbitGhostButtonStyle}"
                            Padding="6,4"
                            ToolTipService.ToolTip="Add 1 minute"
                            Click="OnAddOneMinuteClicked">
                        <TextBlock Text="+1m" FontSize="11" Foreground="{StaticResource OrbitCyanAccentBrush}" />
                    </Button>

                    <Button Style="{StaticResource OrbitGhostButtonStyle}"
                            Padding="6,4"
                            ToolTipService.ToolTip="Pause / Resume"
                            Click="OnTogglePauseClicked">
                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                    </Button>

                    <Button Style="{StaticResource OrbitGhostButtonStyle}"
                            Padding="6,4"
                            ToolTipService.ToolTip="Cancel Timer"
                            Click="OnCancelClicked">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
