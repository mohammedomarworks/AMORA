<UserControl x:Class="AMORA.Orbit.Views.TimerControlView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="{ThemeResource OrbitCardBrush}" BorderBrush="#3D535D" BorderThickness="1" CornerRadius="12" Padding="10,8">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="4">
   <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6"><FontIcon Glyph="&#xE916;" FontSize="13" Foreground="{ThemeResource OrbitCyanAccentBrush}"/><TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding TimeRemainingFormatted}" FontSize="13" Foreground="{ThemeResource OrbitCyanAccentBrush}"/></Grid>
   <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="3"><Button Style="{StaticResource OrbitActionButtonStyle}" Padding="7,3" FontSize="11" Content="5m" AutomationProperties.Name="Start 5 minute timer" Click="OnPreset5Clicked"/><Button Style="{StaticResource OrbitActionButtonStyle}" Padding="7,3" FontSize="11" Content="15m" AutomationProperties.Name="Start 15 minute timer" Click="OnPreset15Clicked"/><Button Style="{StaticResource OrbitActionButtonStyle}" Padding="7,3" FontSize="11" Content="25m" AutomationProperties.Name="Start 25 minute focus timer" Click="OnPreset25Clicked"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource OrbitGhostButtonStyle}" Padding="6,3" IsEnabled="{Binding HasActiveTimer}" Click="OnTogglePauseClicked" AutomationProperties.Name="Pause or Resume Timer"><FontIcon Glyph="{Binding PauseResumeGlyph}" FontSize="11"/></Button><Button Style="{StaticResource OrbitGhostButtonStyle}" Padding="6,3" IsEnabled="{Binding HasActiveTimer}" Click="OnCancelClicked" AutomationProperties.Name="Cancel Timer"><FontIcon Glyph="&#xE711;" FontSize="11"/></Button></StackPanel>
   </Grid>
   <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6"><ProgressBar Value="{Binding ProgressRatio}" Maximum="1" Height="3" VerticalAlignment="Center" Foreground="{ThemeResource OrbitCyanAccentBrush}"/><Button Grid.Column="1" Style="{StaticResource OrbitGhostButtonStyle}" Padding="3,0" FontSize="9" Content="+1m" Click="OnAddOneMinuteClicked" IsEnabled="{Binding HasActiveTimer}" AutomationProperties.Name="Add 1 minute to timer"/></Grid>
  </Grid>
 </Border>
</UserControl>