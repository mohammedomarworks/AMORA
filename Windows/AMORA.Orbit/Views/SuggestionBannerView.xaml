<UserControl
    x:Class="AMORA.Orbit.Views.SuggestionBannerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AMORA.Orbit.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SuggestionViewModel}">

    <Border Background="{StaticResource OrbitCardBrush}"
            BorderBrush="{StaticResource OrbitBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="10,8">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <!-- Icon Badge -->
            <Border Grid.Column="0"
                    Width="24" Height="24"
                    CornerRadius="10"
                    Background="#1F2538"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <FontIcon Glyph="{Binding PriorityGlyph}"
                          FontSize="15"
                          Foreground="{StaticResource OrbitCyanAccentBrush}" />
            </Border>

            <!-- Text Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Category}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource OrbitCyanAccentBrush}" />
                    <TextBlock Text="•"
                               FontSize="11"
                               Foreground="{StaticResource OrbitTextMutedBrush}" />
                    <TextBlock Text="{Binding Title}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource OrbitTextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Text="{Binding Message}"
                           FontSize="11"
                           Foreground="{StaticResource OrbitTextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1" />
            </StackPanel>

            <!-- Action Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}">
                <Button Style="{StaticResource OrbitPrimaryActionButtonStyle}"
                        Padding="10,4"
                        FontSize="11"
                        AutomationProperties.Name="Execute Proactive Suggestion Action"
                        Click="OnExecuteActionClicked">
                    <TextBlock Text="{Binding ActionLabel}" />
                </Button>

                <Button Style="{StaticResource OrbitGhostButtonStyle}"
                        Padding="6,4"
                        ToolTipService.ToolTip="Snooze 15 minutes"
                        AutomationProperties.Name="Snooze Suggestion 15 minutes"
                        Click="OnSnoozeClicked">
                    <FontIcon Glyph="&#xE823;" FontSize="12" />
                </Button>

                <Button Style="{StaticResource OrbitGhostButtonStyle}"
                        Padding="6,4"
                        ToolTipService.ToolTip="Dismiss"
                        AutomationProperties.Name="Dismiss Suggestion"
                        Click="OnDismissClicked">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
