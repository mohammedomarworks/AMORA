<UserControl x:Class="AMORA.Orbit.Views.MediaControlView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="{ThemeResource OrbitCardBrush}" BorderBrush="#3D535D" BorderThickness="1" CornerRadius="12" Padding="10,8">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="4">
   <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="{ThemeResource OrbitCyanAccentBrush}"/>
    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" FontSize="11" Foreground="#A6ABB2" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
   <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
    <TextBlock Text="{Binding SourceName}" FontSize="11" Foreground="{ThemeResource OrbitCyanAccentBrush}" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
     <Button Style="{StaticResource OrbitGhostButtonStyle}" Padding="8,5" IsEnabled="{Binding CanPrevious}" AutomationProperties.Name="Previous Track" Click="OnPreviousClicked"><FontIcon Glyph="&#xE892;" FontSize="11"/></Button>
     <Button Style="{StaticResource OrbitActionButtonStyle}" Padding="8,5" IsEnabled="{Binding CanPlayPause}" AutomationProperties.Name="Play or Pause Media" Click="OnPlayPauseClicked"><FontIcon Glyph="{Binding PlayPauseIconGlyph}" FontSize="11"/></Button>
     <Button Style="{StaticResource OrbitGhostButtonStyle}" Padding="8,5" IsEnabled="{Binding CanNext}" AutomationProperties.Name="Next Track" Click="OnNextClicked"><FontIcon Glyph="&#xE893;" FontSize="11"/></Button>
    </StackPanel>
   </Grid>
   <StackPanel Grid.Row="2" Spacing="2">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}"><ProgressBar Value="{Binding ProgressRatio}" Maximum="1" Height="2" VerticalAlignment="Center" Foreground="{ThemeResource OrbitCyanAccentBrush}"/><TextBlock Grid.Column="1" Text="{Binding FormattedProgress}" FontSize="9" Foreground="#A6ABB2"/></Grid>
    <TextBlock Text="{Binding StatusText}" Visibility="{Binding HasActionStatus, Converter={StaticResource BoolToVis}}" FontSize="10" Foreground="#F3B365" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
