<UserControl x:Class="AMORA.Orbit.Views.OrbitCapsuleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AMORA.Orbit.Views" RequestedTheme="Dark" KeyboardAcceleratorPlacementMode="Hidden">
 <UserControl.KeyboardAccelerators>
  <KeyboardAccelerator Key="Number1" Modifiers="Menu" Invoked="OnHomeAcceleratorInvoked"/>
  <KeyboardAccelerator Key="Number2" Modifiers="Menu" Invoked="OnTalkAcceleratorInvoked"/>
 </UserControl.KeyboardAccelerators>
 <UserControl.Resources>
  <Storyboard x:Name="BreathingGlowStoryboard" RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetName="PillGlowDot" Storyboard.TargetProperty="Opacity" From="0.5" To="1" Duration="0:0:2.4"/></Storyboard>
  <Storyboard x:Name="OpenStoryboard"><DoubleAnimation Storyboard.TargetName="IslandContents" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15"/></Storyboard>
 </UserControl.Resources>
 <Grid x:Name="IslandRoot" Background="Black" SizeChanged="OnIslandSizeChanged" PointerEntered="OnContainerPointerEntered" PointerExited="OnContainerPointerExited" GotFocus="OnIslandGotFocus" LostFocus="OnIslandLostFocus">
  <Button x:Name="CollapsedCapsule" Visibility="{Binding CollapsedIndicatorVisibility, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="16,0" CornerRadius="16" Background="#080A0D" BorderBrush="#34404A" BorderThickness="1" AutomationProperties.Name="Open AMORA island" Click="OnCollapsedPillClicked">
   <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10"><StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><Border Width="4" Height="8" CornerRadius="2" Background="{ThemeResource OrbitCyanAccentBrush}"/><Border Width="4" Height="8" CornerRadius="2" Background="{ThemeResource OrbitCyanAccentBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="AMORA" FontSize="11" CharacterSpacing="140" FontWeight="SemiBold" VerticalAlignment="Center"/><Ellipse x:Name="PillGlowDot" Grid.Column="2" Width="5" Height="5" Fill="{ThemeResource OrbitCyanAccentBrush}"/></Grid>
  </Button>
  <Grid x:Name="ExpandedPanel" Visibility="{Binding ExpandedVisibility, Converter={StaticResource BoolToVis}}" Background="Black">
   <Grid x:Name="IslandContents" RowDefinitions="42,*">
    <Grid Margin="16,0" ColumnDefinitions="Auto,*,Auto">
     <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <Button x:Name="HomeButton" Width="38" Height="30" Style="{StaticResource OrbitGhostButtonStyle}" AutomationProperties.Name="Home" Click="OnHomeClicked"><FontIcon Glyph="&#xE80F;" FontSize="18"/></Button>
      <Button x:Name="TalkButton" Width="38" Height="30" Style="{StaticResource OrbitGhostButtonStyle}" AutomationProperties.Name="Talk to AMORA" Click="OnTalkClicked"><FontIcon Glyph="&#xE8F2;" FontSize="18"/></Button>
      <Button x:Name="QuickButton" Width="38" Height="30" Style="{StaticResource OrbitGhostButtonStyle}" AutomationProperties.Name="Quick actions" Click="OnQuickMenuToggle"><FontIcon Glyph="&#xE710;" FontSize="18"/></Button>
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <Button Width="36" Height="30" Style="{StaticResource OrbitGhostButtonStyle}" AutomationProperties.Name="Settings" Click="OnSettingsToggleClicked"><FontIcon Glyph="&#xE713;" FontSize="18"/></Button>
      <Button Width="36" Height="30" Style="{StaticResource OrbitGhostButtonStyle}" AutomationProperties.Name="Toggle companion sounds" Click="OnSoundClicked"><FontIcon Glyph="{Binding SoundGlyph}" FontSize="18"/></Button>
      <Button Width="30" Height="30" Style="{StaticResource OrbitGhostButtonStyle}" AutomationProperties.Name="Pin island" Click="OnPinToggleClicked"><FontIcon Glyph="{Binding PinIconGlyph}" FontSize="13"/></Button>
      <Button Width="28" Height="30" Style="{StaticResource OrbitGhostButtonStyle}" AutomationProperties.Name="Collapse island" Click="OnCollapseClicked"><FontIcon Glyph="&#xE70E;" FontSize="12"/></Button>
     </StackPanel>
    </Grid>
    <Border x:Name="SurfacePanel" Grid.Row="1" Margin="8,0,8,8" Padding="8" CornerRadius="20" Background="{ThemeResource OrbitSurfaceBrush}" BorderBrush="#343A40" BorderThickness="1">
     <Grid ColumnDefinitions="248,1,*" ColumnSpacing="14">
      <Border Background="{ThemeResource OrbitCardBrush}" CornerRadius="16" Padding="14,12">
       <StackPanel Spacing="9" VerticalAlignment="Top" Margin="0,4,0,0">
        <Viewbox x:Name="MascotSizer" Height="58" Stretch="Uniform"><local:RobotMascotView DataContext="{Binding Mascot}"/></Viewbox>
        <Border Background="#254B5D" CornerRadius="10" Padding="9,2" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="{ThemeResource OrbitCyanAccentBrush}"/><TextBlock Text="{Binding CompanionBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource OrbitCyanAccentBrush}"/></StackPanel></Border>
        <TextBlock Text="{Binding CompanionMessage}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" MaxLines="3"/>
        <StackPanel Spacing="4" Visibility="{Binding Suggestion.HasSuggestion, Converter={StaticResource BoolToVis}}">
         <Button Style="{StaticResource OrbitPrimaryActionButtonStyle}" Content="{Binding Suggestion.ActionLabel}" HorizontalAlignment="Stretch" Click="OnLeftPrimaryActionClicked"/>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Snooze" Style="{StaticResource OrbitGhostButtonStyle}" Click="OnLeftSnoozeClicked"/><Button Content="Dismiss" Style="{StaticResource OrbitGhostButtonStyle}" Click="OnLeftDismissClicked"/></StackPanel>
        </StackPanel>
       </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="#2A2D33" Margin="0,4"/>
      <Grid Grid.Column="2">
       <Grid x:Name="HomePanel" RowDefinitions="Auto,*,*" RowSpacing="8">
        <local:SuggestionBannerView Height="48" Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}" DataContext="{Binding Suggestion}"/>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8"><local:MediaControlView x:Name="HomeMedia" DataContext="{Binding Media}"/><local:TimerControlView x:Name="HomeTimer" Grid.Column="1" DataContext="{Binding Timer}"/></Grid>
        <local:SystemStatusView x:Name="HomeSystemStatus" Grid.Row="2" DataContext="{Binding SystemStatus}"/>
       </Grid>
       <Grid x:Name="TalkPanel" Visibility="Collapsed" RowDefinitions="*,Auto" RowSpacing="8" Padding="8,4">
        <StackPanel x:Name="ChatWelcome" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"><TextBlock Text="What can I help you with?" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/><StackPanel Orientation="Horizontal" Spacing="6"><Button Style="{StaticResource OrbitActionButtonStyle}" Content="25m focus timer" Tag="start a 25 minute timer" Click="OnChatChipClicked"/><Button Style="{StaticResource OrbitActionButtonStyle}" Content="Battery level" Tag="battery level" Click="OnChatChipClicked"/><Button Style="{StaticResource OrbitActionButtonStyle}" Content="Search notes" Click="OnNotesClicked"/></StackPanel></StackPanel>
        <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="8">
         <ItemsControl ItemsSource="{Binding Assistant.Transcript}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#24282E" CornerRadius="10" Padding="10" Margin="0,0,0,6"><StackPanel Spacing="3"><TextBlock Text="{Binding Role}" FontSize="10" Foreground="{ThemeResource OrbitCyanAccentBrush}"/><TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <TextBlock Text="{Binding Assistant.StatusMessage}" Visibility="{Binding Assistant.IsProcessing, Converter={StaticResource BoolToVis}}" Foreground="{ThemeResource OrbitCyanAccentBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
         <StackPanel Visibility="{Binding Assistant.HasPendingConfirmation, Converter={StaticResource BoolToVis}}" Spacing="6"><TextBlock Text="{Binding Assistant.PendingActionDescription}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="6"><Button Content="Confirm" Style="{StaticResource OrbitPrimaryActionButtonStyle}" Click="OnConfirmCommandClicked"/><Button Content="Cancel" Style="{StaticResource OrbitGhostButtonStyle}" Click="OnCancelConfirmationClicked"/></StackPanel></StackPanel>
        </StackPanel></ScrollViewer>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6"><TextBox x:Name="AssistantInputBox" Text="{Binding Assistant.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ask AMORA anything..." Background="#101215" CornerRadius="12" BorderThickness="0" FontSize="13" AutomationProperties.Name="Assistant command input" KeyDown="OnCommandInputKeyDown"/><Button Grid.Column="1" Style="{StaticResource OrbitPrimaryActionButtonStyle}" IsEnabled="{Binding Assistant.CanSubmit}" Click="OnSubmitCommandClicked" AutomationProperties.Name="Send message"><FontIcon Glyph="&#xE72A;" FontSize="16"/></Button><Button Grid.Column="2" Content="Stop" Style="{StaticResource OrbitGhostButtonStyle}" Visibility="{Binding Assistant.IsProcessing, Converter={StaticResource BoolToVis}}" Click="OnStopClicked"/></Grid>
       </Grid>
       <Grid x:Name="TimerPanel" Visibility="Collapsed" Padding="12" RowDefinitions="Auto,*,Auto" RowSpacing="12"><TextBlock Text="Timer &amp; focus" FontSize="18" FontWeight="SemiBold"/><local:TimerControlView Grid.Row="1" DataContext="{Binding Timer}"/><TextBlock Grid.Row="2" Text="5m break · 15m short sprint · 25m focus. The same timer is shared with your commands and automations." TextWrapping="Wrap" FontSize="12" Foreground="#ADB3BB"/></Grid>
     <Grid x:Name="ClipboardPanel" Visibility="Collapsed" Background="#1B1D21" CornerRadius="16" Padding="16" RowDefinitions="Auto,Auto,*" RowSpacing="12">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Clipboard history" FontSize="18" FontWeight="SemiBold"/><Button Grid.Column="1" Style="{StaticResource OrbitGhostButtonStyle}" Content="Clear history" Click="OnClearClipboardClicked" IsEnabled="{Binding Clipboard.HasEntries}"/></Grid>
      <TextBlock Grid.Row="1" Text="{Binding Clipboard.StatusText}" TextWrapping="Wrap" Foreground="#A6ABB2" FontSize="12"/>
      <ScrollViewer Grid.Row="2"><ItemsControl ItemsSource="{Binding Clipboard.Entries}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="#24282D" CornerRadius="10" Padding="12" Margin="0,0,0,8"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><StackPanel><TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxLines="2" FontSize="12"/><TextBlock Text="{Binding TimeLabel}" FontSize="10" Foreground="#A6ABB2"/></StackPanel><Button Grid.Column="1" Style="{StaticResource OrbitActionButtonStyle}" Content="Copy" Tag="{Binding Id}" Click="OnCopyClipboardClicked"/><Button Grid.Column="2" Style="{StaticResource OrbitGhostButtonStyle}" Content="Remove" Tag="{Binding Id}" Click="OnRemoveClipboardClicked"/></Grid></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     </Grid>
     <Grid x:Name="NotesPanel" Visibility="Collapsed" Background="#1B1D21" CornerRadius="16" Padding="16" RowDefinitions="Auto,Auto,*" RowSpacing="10">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Notes" FontSize="18" FontWeight="SemiBold"/><Button Grid.Column="1" Style="{StaticResource OrbitGhostButtonStyle}" Content="New note" Click="OnNewNoteClicked"/></Grid>
      <TextBlock Grid.Row="1" Text="{Binding Workspace.StatusMessage}" TextWrapping="Wrap" Foreground="#8DDDF2" FontSize="11"/>
      <Grid Grid.Row="2" ColumnDefinitions="170,*" ColumnSpacing="14">
       <Grid RowDefinitions="Auto,*" RowSpacing="8"><TextBox Text="{Binding Workspace.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnNoteSearchChanged" PlaceholderText="Search notes" AutomationProperties.Name="Search notes"/>
        <ScrollViewer Grid.Row="1"><ItemsControl ItemsSource="{Binding Workspace.Notes}"><ItemsControl.ItemTemplate><DataTemplate>
         <Button Style="{StaticResource OrbitGhostButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Tag="{Binding Id}" Click="OnSelectNoteClicked" Margin="0,0,0,6"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Preview}" Foreground="#A6ABB2" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></Button>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
       </Grid>
       <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="8"><TextBox Text="{Binding Workspace.NoteTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Note title" AutomationProperties.Name="Note title"/>
        <TextBox Grid.Row="1" Text="{Binding Workspace.NoteBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Write a note. Notes stay on this PC." AutomationProperties.Name="Note body" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button Style="{StaticResource OrbitPrimaryActionButtonStyle}" Content="{Binding Workspace.NoteSaveLabel}" IsEnabled="{Binding Workspace.CanEdit}" Click="OnSaveNoteClicked"/><Button Style="{StaticResource OrbitGhostButtonStyle}" Content="Pin / Unpin" Click="OnPinNoteClicked"/><Button Style="{StaticResource OrbitGhostButtonStyle}" Content="Delete" Click="OnDeleteNoteClicked"/></StackPanel>
       </Grid>
      </Grid>
     </Grid>
     <Grid x:Name="FilesPanel" Visibility="Collapsed" Background="#1B1D21" CornerRadius="16" Padding="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12" AllowDrop="True" DragOver="OnFilesDragOver" Drop="OnFilesDrop">
      <TextBlock Text="File shelf" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Grid.Row="1" Text="Drop files or folders here, or add a path. Only references are saved; your files stay where they are." TextWrapping="Wrap" Foreground="#A6ABB2" FontSize="12"/>
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding Workspace.FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Full file or folder path" AutomationProperties.Name="File shelf path"/><Button Grid.Column="1" Content="Add" Style="{StaticResource OrbitPrimaryActionButtonStyle}" Click="OnAddFileClicked"/></Grid>
      <ScrollViewer Grid.Row="3"><StackPanel Spacing="8"><TextBlock Text="{Binding Workspace.StatusMessage}" TextWrapping="Wrap" Foreground="#8DDDF2" FontSize="11"/><ItemsControl ItemsSource="{Binding Workspace.Shelf}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="#24282D" CornerRadius="10" Padding="10" Margin="0,0,0,8"><Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6"><StackPanel><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#A6ABB2" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Style="{StaticResource OrbitActionButtonStyle}" Content="Open" Tag="{Binding Id}" Click="OnOpenFileClicked"/><Button Grid.Column="2" Style="{StaticResource OrbitGhostButtonStyle}" Content="Show" Tag="{Binding Id}" Click="OnRevealFileClicked"/><Button Grid.Column="3" Style="{StaticResource OrbitGhostButtonStyle}" Content="{Binding PinText}" Tag="{Binding Id}" Click="OnPinFileClicked"/><Button Grid.Column="4" Style="{StaticResource OrbitGhostButtonStyle}" Content="Remove" Tag="{Binding Id}" Click="OnRemoveFileClicked"/></Grid></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
     </Grid>

       <ScrollViewer x:Name="AutomationsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <!-- Automations Panel Drawer (Collapsible) -->
                <Border Grid.Row="0"
                        Background="#161822"
                        BorderBrush="{StaticResource OrbitBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14,12"
                        x:Name="AutomationsPanel" Visibility="{Binding Automations.IsOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="10">
                        <!-- Drawer Header -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{StaticResource OrbitCyanAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Local Automations &amp; Schedules" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OrbitTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource OrbitGhostButtonStyle}" Padding="6,2"
                                    AutomationProperties.Name="Close Automations"
                                    Click="OnCloseAutomationsClicked">
                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                            </Button>
                        </Grid>

                        <!-- Active Automations List -->
                        <ItemsControl ItemsSource="{Binding Automations.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0D0F17" BorderBrush="#222634" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OrbitTextPrimaryBrush}" />
                                                <TextBlock Text="{Binding TriggerText}" FontSize="10" Foreground="{StaticResource OrbitCyanAccentBrush}" />
                                                <TextBlock Text="{Binding ActionText}" FontSize="11" Foreground="{StaticResource OrbitTextMutedBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource OrbitGhostButtonStyle}" Padding="6,3" FontSize="10"
                                                    ToolTipService.ToolTip="Run Now"
                                                    AutomationProperties.Name="Run Automation Now"
                                                    Tag="{Binding Id}" Click="OnRunAutomationNowClicked">
                                                <FontIcon Glyph="&#xE768;" FontSize="10" />
                                            </Button>
                                            <Button Grid.Column="2" Style="{StaticResource OrbitGhostButtonStyle}" Padding="6,3" FontSize="10"
                                                    ToolTipService.ToolTip="Delete"
                                                    AutomationProperties.Name="Delete Automation"
                                                    Tag="{Binding Id}" Click="OnDeleteAutomationClicked">
                                                <FontIcon Glyph="&#xE74D;" FontSize="10" Foreground="#FF453A" />
                                            </Button>
                                            <ToggleSwitch Grid.Column="3" IsOn="{Binding IsEnabled, Mode=OneWay}"
                                                          AutomationProperties.Name="Toggle Automation Enabled State"
                                                          OnContent="" OffContent="" MinWidth="0"
                                                          Tag="{Binding Id}" Toggled="OnAutomationToggled" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Create New Automation Form -->
                        <Border Background="#10121C" BorderBrush="#2A2E3D" BorderThickness="1" CornerRadius="10" Padding="10,8">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Create New Automation" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OrbitCyanAccentBrush}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <TextBox Grid.Column="0" PlaceholderText="Automation name..." Text="{Binding Automations.NewName, Mode=TwoWay}"
                                             AutomationProperties.Name="New Automation Name"
                                             FontSize="12" Padding="6,3" Background="#090B10" BorderBrush="#2A2E3D" Foreground="{StaticResource OrbitTextPrimaryBrush}" />
                                    <TextBox Grid.Column="1" PlaceholderText="Reminder message..." Text="{Binding Automations.NewReminderMessage, Mode=TwoWay}"
                                             AutomationProperties.Name="New Automation Reminder Message"
                                             FontSize="12" Padding="6,3" Background="#090B10" BorderBrush="#2A2E3D" Foreground="{StaticResource OrbitTextPrimaryBrush}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0" SelectedIndex="{Binding Automations.NewTriggerTypeIndex, Mode=TwoWay}"
                                              AutomationProperties.Name="New Automation Trigger Schedule"
                                              Background="#090B10" BorderBrush="#2A2E3D" Foreground="{StaticResource OrbitTextPrimaryBrush}"
                                              FontSize="10" Padding="6,2">
                                        <ComboBoxItem Content="Daily Schedule (9 AM)" />
                                        <ComboBoxItem Content="Every 30 Mins" />
                                        <ComboBoxItem Content="Every 60 Mins" />
                                    </ComboBox>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding Automations.NewActionTypeIndex, Mode=TwoWay}"
                                              AutomationProperties.Name="New Automation Action Type"
                                              Background="#090B10" BorderBrush="#2A2E3D" Foreground="{StaticResource OrbitTextPrimaryBrush}"
                                              FontSize="10" Padding="6,2">
                                        <ComboBoxItem Content="Show Reminder" />
                                        <ComboBoxItem Content="Start 25m Timer" />
                                        <ComboBoxItem Content="Pause Media" />
                                    </ComboBox>
                                    <Button Grid.Column="3" Style="{StaticResource OrbitPrimaryActionButtonStyle}" Padding="10,4" FontSize="10"
                                            AutomationProperties.Name="Add Automation"
                                            Click="OnCreateAutomationClicked">
                                        <TextBlock Text="Add Automation" FontSize="10" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Status Indicator -->
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding Automations.HasStatusMessage, Converter={StaticResource BoolToVis}}">
                            <FontIcon Glyph="{Binding Automations.StatusGlyph}" FontSize="11" Foreground="{Binding Automations.StatusColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Automations.StatusMessage}" FontSize="10" Foreground="{Binding Automations.StatusColor}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                        </StackPanel>
                    </StackPanel>
                </Border>


       </ScrollViewer>
       <local:GitHubPanelView x:Name="GitHubPanel" Visibility="Collapsed" DataContext="{Binding GitHub}"/>
      </Grid>
     </Grid>
    </Border>
   </Grid>
   <Grid x:Name="QuickMenuLayer" Visibility="Collapsed">
    <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnCloseQuickMenu" AutomationProperties.Name="Close quick actions"/>
    <Border Width="190" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="98,42,0,0" Background="#FA090B0D" BorderBrush="#3B3D41" BorderThickness="1" CornerRadius="14" Padding="8">
     <ScrollViewer MaxHeight="214" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="2">
      <Button Content="◷   Timer" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource OrbitGhostButtonStyle}" Click="OnTimerPageClicked"/>
      <Button Content="▣   Clipboard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource OrbitGhostButtonStyle}" Click="OnClipboardClicked"/>
      <Button Content="▤   Notes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource OrbitGhostButtonStyle}" Click="OnNotesClicked"/>
      <Button Content="▱   File shelf" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource OrbitGhostButtonStyle}" Click="OnFilesClicked"/>
      <Button Content="ϟ   Automations" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource OrbitGhostButtonStyle}" Click="OnAutomationsToggleClicked"/>
      <Button Content="&lt;/&gt; GitHub" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource OrbitGhostButtonStyle}" Click="OnGitHubClicked"/>
      <Button Content="New conversation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource OrbitGhostButtonStyle}" Click="OnResetConversationClicked"/>
     </StackPanel></ScrollViewer>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
