<UserControl
    x:Class="AMORA.Orbit.Views.OrbitCapsuleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AMORA.Orbit.Views"
    xmlns:vm="using:AMORA.Orbit.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:OrbitViewModel}">

    <UserControl.Resources>
        <!-- Storyboard for Collapsed Pill Cyan Breathing Glow -->
        <Storyboard x:Name="BreathingGlowStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PillGlowDot"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="1.0"
                             Duration="0:0:1.8" />
        </Storyboard>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Top"
          PointerEntered="OnContainerPointerEntered"
          PointerExited="OnContainerPointerExited">

        <!-- ========================================== -->
        <!-- 1. COLLAPSED FLOATING CAPSULE PILL         -->
        <!-- ========================================== -->
        <Border x:Name="CollapsedCapsule"
                Visibility="{Binding CollapsedIndicatorVisibility, Converter={StaticResource BoolToVis}}"
                Width="240" Height="38"
                CornerRadius="19"
                Background="#EE0D0F17"
                BorderBrush="{StaticResource OrbitBorderBrush}"
                BorderThickness="1"
                Padding="10,4"
                Tapped="OnCollapsedPillTapped">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <!-- Mini Mascot Icon / Face -->
                <Border Grid.Column="0"
                        Width="22" Height="22"
                        CornerRadius="11"
                        Background="#161822"
                        BorderBrush="#252A3A"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE99A;" FontSize="11" Foreground="{StaticResource OrbitCyanAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Breathing Status Indicator Dot -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Width="8" Height="8">
                    <Ellipse x:Name="PillGlowDot" Fill="{StaticResource OrbitCyanGlowBrush}" Width="8" Height="8" Opacity="0.8" />
                    <Ellipse Fill="{StaticResource OrbitCyanAccentBrush}" Width="5" Height="5" />
                </Grid>

                <!-- Status Label -->
                <TextBlock Grid.Column="2"
                           Text="AMORA Orbit"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource OrbitTextPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Expand Indicator -->
                <FontIcon Grid.Column="3"
                          Glyph="&#xE70D;"
                          FontSize="10"
                          Foreground="{StaticResource OrbitTextMutedBrush}"
                          VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- 2. EXPANDED INTERACTIVE PANEL              -->
        <!-- ========================================== -->
        <Border x:Name="ExpandedPanel"
                Visibility="{Binding ExpandedVisibility, Converter={StaticResource BoolToVis}}"
                Width="660"
                MaxHeight="520"
                CornerRadius="24"
                Background="#FA0D0F17"
                BorderBrush="{StaticResource OrbitBorderBrush}"
                BorderThickness="1.5"
                Padding="18,14">
            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                <!-- Header Toolbar -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <!-- Branding & Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="13" Background="#161822" BorderBrush="#2A2E3D" BorderThickness="1">
                            <FontIcon Glyph="&#xE99A;" FontSize="13" Foreground="{StaticResource OrbitCyanAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="AMORA Orbit" FontSize="14" FontWeight="Bold" Foreground="{StaticResource OrbitTextPrimaryBrush}" VerticalAlignment="Center" />
                        <Border Background="#1C2130" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="WINDOWS COMPANION" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource OrbitCyanAccentBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Header Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <!-- New Conversation Button -->
                        <Button Style="{StaticResource OrbitGhostButtonStyle}"
                                Padding="8,4"
                                ToolTipService.ToolTip="New Conversation (Reset Chat)"
                                Click="OnResetConversationClicked">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        </Button>

                        <!-- Settings Toggle Button -->
                        <Button Style="{StaticResource OrbitGhostButtonStyle}"
                                Padding="8,4"
                                ToolTipService.ToolTip="AI &amp; Secure Settings"
                                Click="OnSettingsToggleClicked">
                            <FontIcon Glyph="&#xE713;" FontSize="13" />
                        </Button>

                        <!-- Pin Toggle Button -->
                        <Button Style="{StaticResource OrbitGhostButtonStyle}"
                                Padding="8,4"
                                ToolTipService.ToolTip="Keep Orbit Open (Pin)"
                                Click="OnPinToggleClicked">
                            <FontIcon Glyph="{Binding PinIconGlyph}" FontSize="13" />
                        </Button>

                        <!-- Collapse Button -->
                        <Button Style="{StaticResource OrbitGhostButtonStyle}"
                                Padding="8,4"
                                ToolTipService.ToolTip="Collapse to Capsule (Esc)"
                                Click="OnCollapseClicked">
                            <FontIcon Glyph="&#xE70E;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Settings Panel Drawer (Collapsible) -->
                <Border Grid.Row="1"
                        Background="#161822"
                        BorderBrush="{StaticResource OrbitBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14,12"
                        Visibility="{Binding Settings.IsOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE713;" FontSize="12" Foreground="{StaticResource OrbitCyanAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="AI Provider &amp; Secure Credentials" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OrbitTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource OrbitGhostButtonStyle}" Padding="6,2" Click="OnCloseSettingsClicked">
                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                            </Button>
                        </Grid>

                        <!-- Provider & Model Selection -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Provider" FontSize="10" Foreground="{StaticResource OrbitTextMutedBrush}" />
                                <TextBox Text="{Binding Settings.SelectedProvider, Mode=TwoWay}"
                                         FontSize="11" Padding="8,4" Background="#0D0F17" BorderBrush="#2A2E3D"
                                         Foreground="{StaticResource OrbitTextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Model" FontSize="10" Foreground="{StaticResource OrbitTextMutedBrush}" />
                                <TextBox Text="{Binding Settings.ModelName, Mode=TwoWay}"
                                         FontSize="11" Padding="8,4" Background="#0D0F17" BorderBrush="#2A2E3D"
                                         Foreground="{StaticResource OrbitTextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- API Key Input & Masked Display -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Google Gemini API Key" FontSize="10" Foreground="{StaticResource OrbitTextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Settings.MaskedApiKey}" FontSize="10" Foreground="{StaticResource OrbitCyanAccentBrush}"
                                           Visibility="{Binding Settings.HasSavedKey, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <PasswordBox x:Name="SettingsApiKeyBox"
                                         PlaceholderText="Paste Gemini API key (encrypted with Windows DPAPI)..."
                                         PasswordChanged="OnSettingsApiKeyPasswordChanged"
                                         FontSize="11" Padding="8,4" Background="#0D0F17" BorderBrush="#2A2E3D"
                                         Foreground="{StaticResource OrbitTextPrimaryBrush}" />
                        </StackPanel>

                        <!-- Context Awareness Privacy Toggle -->
                        <CheckBox IsChecked="{Binding Settings.SendStatusContextToAI, Mode=TwoWay}"
                                  Margin="0,2,0,2">
                            <TextBlock Text="Share system status with AI (active timer, media, power; default: Off)"
                                       FontSize="10" Foreground="{StaticResource OrbitTextMutedBrush}" VerticalAlignment="Center" />
                        </CheckBox>

                        <!-- Action Buttons & Status -->
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Style="{StaticResource OrbitPrimaryActionButtonStyle}"
                                    Padding="10,4" FontSize="11" Click="OnSaveSettingsClicked">
                                <TextBlock Text="Save" FontSize="11" />
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource OrbitGhostButtonStyle}"
                                    Padding="10,4" FontSize="11" Click="OnTestConnectionClicked"
                                    IsEnabled="{Binding Settings.CanTest}">
                                <TextBlock Text="Test Connection" FontSize="11" />
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource OrbitGhostButtonStyle}"
                                    Padding="10,4" FontSize="11" Click="OnClearKeyClicked"
                                    Visibility="{Binding Settings.HasSavedKey, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Clear Key" FontSize="11" Foreground="#FF453A" />
                            </Button>

                            <!-- Test / Save Status Indicator -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="{Binding Settings.HasTestStatus, Converter={StaticResource BoolToVis}}">
                                <FontIcon Glyph="{Binding Settings.TestStatusGlyph}" FontSize="11" Foreground="{Binding Settings.TestStatusColor}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Settings.TestStatusMessage}" FontSize="10" Foreground="{Binding Settings.TestStatusColor}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            </StackPanel>
                        </Grid>

                        <!-- Security Notice -->
                        <TextBlock Text="&#xE72E; Credentials are encrypted via Windows DPAPI for your user account. Keys are never written to disk in plaintext."
                                   FontSize="9" Foreground="#6C7280" />
                    </StackPanel>
                </Border>

                <!-- Assistant Command Input Bar -->
                <Border Grid.Row="2"
                        Background="{StaticResource OrbitCardBrush}"
                        BorderBrush="{StaticResource OrbitBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="12,8">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                        <!-- Input Row -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0"
                                    Width="24" Height="24"
                                    CornerRadius="12"
                                    Background="#1C2130"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE756;" FontSize="11" Foreground="{StaticResource OrbitCyanAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBox Grid.Column="1"
                                     x:Name="AssistantInputBox"
                                     Text="{Binding Assistant.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Ask AMORA or command (e.g. 'start 15m timer', 'pause music')..."
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource OrbitTextPrimaryBrush}"
                                     FontSize="12"
                                     VerticalAlignment="Center"
                                     KeyDown="OnCommandInputKeyDown" />

                            <Button Grid.Column="2"
                                    Style="{StaticResource OrbitPrimaryActionButtonStyle}"
                                    Padding="10,4"
                                    FontSize="11"
                                    IsEnabled="{Binding Assistant.CanSubmit}"
                                    Click="OnSubmitCommandClicked"
                                    ToolTipService.ToolTip="Execute Command (Enter)">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Ask" FontSize="11" />
                                    <FontIcon Glyph="&#xE724;" FontSize="10" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3"
                                    Style="{StaticResource OrbitGhostButtonStyle}"
                                    Padding="6,4"
                                    Visibility="{Binding Assistant.HasText, Converter={StaticResource BoolToVis}}"
                                    Click="OnClearCommandClicked"
                                    ToolTipService.ToolTip="Clear">
                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                            </Button>
                        </Grid>

                        <!-- Feedback & Confirmation Banner -->
                        <Grid Grid.Row="1"
                              Visibility="{Binding Assistant.HasStatus, Converter={StaticResource BoolToVis}}"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="8"
                              Margin="2,0,0,0">
                            <FontIcon Grid.Column="0"
                                      Glyph="{Binding Assistant.StatusGlyph}"
                                      FontSize="12"
                                      Foreground="{Binding Assistant.StatusColor}"
                                      VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Assistant.StatusMessage}"
                                       FontSize="11"
                                       Foreground="{Binding Assistant.StatusColor}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Confirmation Action Controls -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Visibility="{Binding Assistant.HasPendingConfirmation, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource OrbitPrimaryActionButtonStyle}"
                                        Padding="8,3"
                                        FontSize="10"
                                        Background="#FF9F0A"
                                        Click="OnConfirmCommandClicked">
                                    <TextBlock Text="Confirm" FontSize="10" Foreground="#090B10" FontWeight="SemiBold" />
                                </Button>
                                <Button Style="{StaticResource OrbitGhostButtonStyle}"
                                        Padding="8,3"
                                        FontSize="10"
                                        Click="OnCancelConfirmationClicked">
                                    <TextBlock Text="Cancel" FontSize="10" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Main Content (2 Columns) -->
                <Grid Grid.Row="3" ColumnDefinitions="210,*" ColumnSpacing="16">
                    <!-- LEFT COLUMN: Robot Mascot & Proactive Recommendation -->
                    <Border Grid.Column="0"
                            Background="{StaticResource OrbitCardBrush}"
                            BorderBrush="{StaticResource OrbitBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="12,14">
                        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                            <!-- Mascot Representation -->
                            <local:RobotMascotView Grid.Row="0" DataContext="{Binding Mascot}" />

                            <!-- Mascot Mood / State -->
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Mascot.StatusDescription}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource OrbitTextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Mascot.StatusSubtext}"
                                           FontSize="10"
                                           Foreground="{StaticResource OrbitTextMutedBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Mini Proactive Card -->
                            <Border Grid.Row="2"
                                    Background="#11131C"
                                    BorderBrush="#222634"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,8"
                                    VerticalAlignment="Bottom">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Smart Insight"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource OrbitCyanAccentBrush}" />
                                    <TextBlock Text="{Binding Suggestion.Title}"
                                               FontSize="11"
                                               Foreground="{StaticResource OrbitTextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               MaxLines="3" />
                                </StackPanel>
                            </Border>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Row="3" Spacing="6">
                                <Button Style="{StaticResource OrbitPrimaryActionButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Click="OnLeftPrimaryActionClicked">
                                    <TextBlock Text="{Binding Suggestion.ActionLabel}" HorizontalAlignment="Center" />
                                </Button>
                                <Grid ColumnDefinitions="*,*">
                                    <Button Grid.Column="0"
                                            Style="{StaticResource OrbitGhostButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Padding="4,4"
                                            Click="OnLeftSnoozeClicked">
                                        <TextBlock Text="Snooze" FontSize="11" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource OrbitGhostButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Padding="4,4"
                                            Click="OnLeftDismissClicked">
                                        <TextBlock Text="Dismiss" FontSize="11" HorizontalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- RIGHT COLUMN: Banner, Media & Timer, System Status -->
                    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <!-- Top Suggestion Banner -->
                        <local:SuggestionBannerView Grid.Row="0" DataContext="{Binding Suggestion}" />

                        <!-- Center: Media and Focus Timer Cards -->
                        <Grid Grid.Row="1" RowDefinitions="*,*" RowSpacing="10">
                            <!-- Media Player -->
                            <local:MediaControlView Grid.Row="0" DataContext="{Binding Media}" />

                            <!-- Focus Timer -->
                            <local:TimerControlView Grid.Row="1" DataContext="{Binding Timer}" />
                        </Grid>

                        <!-- Bottom: Battery & Hardware Telemetry -->
                        <local:SystemStatusView Grid.Row="2" DataContext="{Binding SystemStatus}" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
