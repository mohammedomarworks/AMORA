<Application
    x:Class="AMORA.Orbit.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:AMORA.Orbit.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Load the standard WinUI control templates and theme resources before app styles. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- AMORA Orbit Theme Colors -->
            <Color x:Key="OrbitSurfaceColor">#0B0D10</Color>
            <Color x:Key="OrbitCardColor">#202226</Color>
            <Color x:Key="OrbitCardSubtleColor">#292D32</Color>
            <Color x:Key="OrbitBorderColor">#35434D</Color>
            <Color x:Key="OrbitCyanAccentColor">#52CCFF</Color>
            <Color x:Key="OrbitCyanGlowColor">#8CE8FF</Color>
            <Color x:Key="OrbitTextPrimaryColor">#F0F3F8</Color>
            <Color x:Key="OrbitTextSecondaryColor">#9AA2B2</Color>
            <Color x:Key="OrbitTextMutedColor">#646C7E</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="OrbitSurfaceBrush" Color="{StaticResource OrbitSurfaceColor}" />
            <SolidColorBrush x:Key="OrbitCardBrush" Color="{StaticResource OrbitCardColor}" />
            <SolidColorBrush x:Key="OrbitCardSubtleBrush" Color="{StaticResource OrbitCardSubtleColor}" />
            <SolidColorBrush x:Key="OrbitBorderBrush" Color="{StaticResource OrbitBorderColor}" />
            <SolidColorBrush x:Key="OrbitCyanAccentBrush" Color="{StaticResource OrbitCyanAccentColor}" />
            <SolidColorBrush x:Key="OrbitCyanGlowBrush" Color="{StaticResource OrbitCyanGlowColor}" />
            <SolidColorBrush x:Key="OrbitTextPrimaryBrush" Color="{StaticResource OrbitTextPrimaryColor}" />
            <SolidColorBrush x:Key="OrbitTextSecondaryBrush" Color="{StaticResource OrbitTextSecondaryColor}" />
            <SolidColorBrush x:Key="OrbitTextMutedBrush" Color="{StaticResource OrbitTextMutedColor}" />
            <!-- App-owned accent overrides use the same mutable brand brush.
                 Standard WinUI templates still come from XamlControlsResources. -->
            <StaticResource x:Key="SliderThumbBackground" ResourceKey="OrbitCyanAccentBrush" />
            <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="OrbitCyanAccentBrush" />
            <StaticResource x:Key="SliderTrackValueFill" ResourceKey="OrbitCyanAccentBrush" />
            <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="OrbitCyanAccentBrush" />
            <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="OrbitCyanAccentBrush" />
            <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="OrbitCyanAccentBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="OrbitCyanAccentBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="OrbitCyanAccentBrush" />
            <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#354C58" />
            <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#405763" />

            <!-- Standard Capsule Button Style -->
            <Style x:Key="OrbitActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#2C3035" />
                <Setter Property="Foreground" Value="{StaticResource OrbitTextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource OrbitBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="OrbitPrimaryActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource OrbitCyanAccentBrush}" />
                <Setter Property="Foreground" Value="#090B10" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="OrbitGhostButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource OrbitTextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
