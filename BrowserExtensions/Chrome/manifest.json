{
  "manifest_version": 3,
  "name": "AMORA Browser Media Helper",
  "version": "1.0.0",
  "description": "Reports active YouTube HTML5 media state to AMORA.",
  "permissions": ["tabs", "nativeMessaging"],
  "key": "",
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://youtu.be/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/watch*", "https://www.youtube.com/shorts/*", "https://youtu.be/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
